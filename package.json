{
  "name": "vscode-ptxdist",
  "displayName": "vscode-ptxdist",
  "description": "vscode extension for ptxdist",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "ptxdistIn",
      "extensions": [".in"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "ptxdistIn",
      "scopeName": "source.in",
      "path": "./syntaxes/ptxdistIn.tmLanguage.json"
    }]
  }
}
