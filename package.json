{
	"name": "vscode-ptxdist",
	"displayName": "vscode-ptxdist",
	"description": "vscode extension for ptxdist",
	"version": "0.0.1",
	"keywords": [
		"multi-root ready"
	],
	"engines": {
		"vscode": "^1.93.0"
	},
	"categories": [
		"Programming Languages"
	],
	"activationEvents": [],
	"main": "./client/out/extension",
	"contributes": {
		"languages": [
			{
				"id": "ptxdistIn",
				"extensions": [
					".in"
				],
				"configuration": "./language-configuration.json"
			},
			{
				"id": "ptxdistMake",
				"extensions": [
					".make"
				],
				"configuration": "./ptxdistMake-language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "ptxdistIn",
				"scopeName": "source.in",
				"path": "./syntaxes/ptxdistIn.tmLanguage.json"
			},
			{
				"language": "ptxdistMake",
				"scopeName": "source.make",
				"path": "./syntaxes/ptxdistMake.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "ptxdistMake",
				"path": "snippets/ptxdistMake/snippets.json"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -b",
		"watch": "tsc -b -w",
		"lint": "eslint ./client/src --ext .ts,.tsx",
		"postinstall": "cd client && npm install && cd ..",
		"test": "sh ./scripts/e2e.sh"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.6",
		"@types/node": "^18.14.6",
		"@types/vscode": "^1.73.0",
		"@typescript-eslint/eslint-plugin": "^7.1.0",
		"@typescript-eslint/parser": "^7.1.0",
		"eslint": "^8.57.0",
		"mocha": "^10.3.0",
		"typescript": "^5.3.3"
	}
}